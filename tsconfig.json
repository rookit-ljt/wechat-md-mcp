{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@md/core": ["vendor/doocs-md/core/src/index.ts"],
      "@md/core/*": ["vendor/doocs-md/core/src/*"],
      "@md/shared": ["vendor/doocs-md/shared/src/index.ts"],
      "@md/shared/*": ["vendor/doocs-md/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
